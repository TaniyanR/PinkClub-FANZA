<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>管理者ログイン | <%= settings.site_name %></title>
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body class="login-page">
  <div class="login-wrap">
    <div class="login-card">
      <div style="text-align:center;margin-bottom:16px;">
        <span style="display:inline-block;padding:4px 10px;background:#ffeef6;color:#d81b60;font-size:12px;font-weight:bold;border-radius:4px;">
          PINKCLUB MANAGEMENT
        </span>
      </div>
      <h1 class="login-title" style="text-align:center;font-size:22px;color:#1d2327;">管理者ログイン</h1>
      <p class="login-subtitle" style="text-align:center;margin-bottom:20px;font-size:13px;">PinkClub FANZA 管理パネルへようこそ</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error" style="background:#fdf0f0;border:1px solid #d63638;color:#d63638;padding:10px 12px;border-radius:4px;font-size:13px;margin-bottom:16px;">
          <%= error %>
        </div>
      <% } %>

      <form action="/public/login0718.php" method="post" class="login-form">
        <label class="login-label">
          <span>ユーザー名</span>
          <input type="text" name="username" class="login-input" placeholder="admin" value="admin" required autofocus>
        </label>

        <label class="login-label">
          <span>パスワード</span>
          <input type="password" name="password" class="login-input" placeholder="password" value="password" required>
        </label>

        <button type="submit" class="login-button" style="background:#2271b1;color:#fff;font-weight:bold;border-radius:4px;padding:12px;cursor:pointer;border:none;margin-top:10px;">
          ログイン
        </button>
      </form>

      <div class="login-note" style="margin-top:20px;padding:12px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;font-size:12px;color:#666;">
        <strong>初期ログイン情報:</strong><br>
        ユーザー名: <code style="background:#eee;padding:1px 4px;border-radius:3px;">admin</code><br>
        パスワード: <code style="background:#eee;padding:1px 4px;border-radius:3px;">password</code>
      </div>

      <div style="margin-top:16px;text-align:center;">
        <a href="/" style="font-size:13px;color:#666;text-decoration:none;">&larr; サイトトップへ戻る</a>
      </div>
    </div>
  </div>
</body>
</html>
