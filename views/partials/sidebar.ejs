<aside class="site-sidebar">
  <div style="background:#fff;border:1px solid #dcdcde;border-radius:8px;padding:16px;margin-bottom:16px;">
    <h3 style="margin:0 0 12px;font-size:16px;color:#1d2327;border-left:4px solid #ff4da6;padding-left:8px;">人気作品ピックアップ</h3>
    <div style="display:flex;flex-direction:column;gap:12px;">
      <% (sidebarPopularItems || []).slice(0, 4).forEach(function(item) { %>
        <div style="display:flex;gap:10px;align-items:center;">
          <a href="/item/<%= item.id %>" style="flex:0 0 70px;">
            <img src="<%= item.image_small %>" alt="<%= item.title %>" style="width:70px;height:52px;object-fit:cover;border-radius:4px;display:block;">
          </a>
          <div style="min-width:0;flex:1;">
            <a href="/item/<%= item.id %>" style="font-size:12px;font-weight:bold;color:#1d2327;text-decoration:none;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.4;">
              <%= item.title %>
            </a>
            <div style="font-size:11px;color:#d81b60;margin-top:2px;">★ <%= item.review_average || '4.5' %> (<%= item.review_count || 0 %>件)</div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>

  <div style="background:#fff;border:1px solid #dcdcde;border-radius:8px;padding:16px;margin-bottom:16px;">
    <h3 style="margin:0 0 12px;font-size:16px;color:#1d2327;border-left:4px solid #ff4da6;padding-left:8px;">注目・人気女優</h3>
    <div style="display:grid;grid-template-columns:repeat(2, 1fr);gap:8px;">
      <% (sidebarActresses || []).slice(0, 6).forEach(function(actress) { %>
        <a href="/actress/<%= actress.id %>" style="display:flex;flex-direction:column;align-items:center;text-decoration:none;padding:6px;border:1px solid #f0f0f0;border-radius:6px;background:#fafafa;">
          <img src="<%= actress.image_small %>" alt="<%= actress.name %>" style="width:48px;height:48px;border-radius:50%;object-fit:cover;margin-bottom:4px;">
          <span style="font-size:12px;font-weight:bold;color:#2271b1;text-align:center;"><%= actress.name %></span>
          <span style="font-size:10px;color:#888;"><%= actress.cup ? actress.cup + 'カップ' : '' %></span>
        </a>
      <% }); %>
    </div>
  </div>

  <div style="background:#fff;border:1px solid #dcdcde;border-radius:8px;padding:16px;margin-bottom:16px;">
    <h3 style="margin:0 0 12px;font-size:16px;color:#1d2327;border-left:4px solid #ff4da6;padding-left:8px;">人気ジャンル</h3>
    <div style="display:flex;flex-wrap:wrap;gap:6px;">
      <% (sidebarGenres || []).forEach(function(genre) { %>
        <a href="/genre/<%= genre.id %>" style="font-size:12px;color:#333;background:#f3f4f6;border:1px solid #e5e7eb;padding:4px 8px;border-radius:4px;text-decoration:none;">
          #<%= genre.name %>
        </a>
      <% }); %>
    </div>
  </div>

  <div style="background:#fff;border:1px solid #dcdcde;border-radius:8px;padding:16px;margin-bottom:16px;">
    <h3 style="margin:0 0 12px;font-size:16px;color:#1d2327;border-left:4px solid #ff4da6;padding-left:8px;">相互リンク</h3>
    <ul style="margin:0;padding-left:18px;font-size:13px;line-height:1.8;">
      <% (sidebarLinks || []).forEach(function(link) { %>
        <li>
          <a href="/out?id=<%= link.id %>" target="_blank" rel="noopener noreferrer" style="color:#2271b1;text-decoration:none;">
            <%= link.site_name %>
          </a>
        </li>
      <% }); %>
    </ul>
    <div style="margin-top:10px;text-align:right;">
      <a href="/links" style="font-size:12px;color:#ff4da6;text-decoration:none;">相互リンク申請はこちら &raquo;</a>
    </div>
  </div>
</aside>
