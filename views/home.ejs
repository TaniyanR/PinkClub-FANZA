<%- include('partials/header') %>

<div style="margin-bottom:24px;">
  <!-- Pickup Section -->
  <div style="background:#fff;border:1px solid #dcdcde;border-radius:8px;padding:20px;margin-bottom:24px;box-shadow:0 2px 8px rgba(0,0,0,0.03);">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;border-bottom:2px solid #ff4da6;padding-bottom:8px;">
      <h2 style="margin:0;font-size:20px;color:#1d2327;display:flex;align-items:center;gap:8px;">
        <span style="background:#ff4da6;color:#fff;padding:2px 8px;border-radius:4px;font-size:12px;">PICK UP</span>
        殿堂入り・人気おすすめ作品
      </h2>
      <a href="/search?sort=popular" style="font-size:13px;color:#ff4da6;text-decoration:none;">もっと見る &raquo;</a>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(220px, 1fr));gap:16px;">
      <% popularItems.forEach(function(item) { %>
        <div style="border:1px solid #eee;border-radius:6px;overflow:hidden;background:#fafafa;display:flex;flex-direction:column;transition:transform 0.2s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
          <a href="/item/<%= item.id %>" style="position:relative;display:block;overflow:hidden;background:#000;">
            <img src="<%= item.image_large || item.image_small %>" alt="<%= item.title %>" style="width:100%;height:160px;object-fit:cover;display:block;">
            <span style="position:absolute;top:6px;left:6px;background:rgba(216,27,96,0.85);color:#fff;font-size:11px;padding:2px 6px;border-radius:3px;font-weight:bold;">
              ★ <%= item.review_average %>
            </span>
            <span style="position:absolute;bottom:6px;right:6px;background:rgba(0,0,0,0.7);color:#fff;font-size:10px;padding:2px 6px;border-radius:3px;">
              <%= item.volume %>
            </span>
          </a>
          <div style="padding:12px;display:flex;flex-direction:column;flex:1;">
            <a href="/item/<%= item.id %>" style="font-size:13px;font-weight:bold;color:#1d2327;text-decoration:none;line-height:1.4;margin-bottom:8px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
              <%= item.title %>
            </a>
            <div style="margin-top:auto;display:flex;justify-content:space-between;align-items:center;font-size:12px;">
              <span style="color:#d81b60;font-weight:bold;"><%= item.price_min_text %></span>
              <span style="color:#888;font-size:11px;"><%= item.release_date %></span>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>

  <!-- New Releases Section -->
  <div style="background:#fff;border:1px solid #dcdcde;border-radius:8px;padding:20px;margin-bottom:24px;box-shadow:0 2px 8px rgba(0,0,0,0.03);">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;border-bottom:2px solid #2271b1;padding-bottom:8px;">
      <h2 style="margin:0;font-size:20px;color:#1d2327;display:flex;align-items:center;gap:8px;">
        <span style="background:#2271b1;color:#fff;padding:2px 8px;border-radius:4px;font-size:12px;">NEW</span>
        最新リリース作品一覧
      </h2>
      <span style="font-size:13px;color:#666;">全 <%= totalItems %> 件中 最新</span>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(260px, 1fr));gap:16px;">
      <% newItems.forEach(function(item) { %>
        <div style="border:1px solid #e2e4e7;border-radius:6px;overflow:hidden;background:#fff;display:flex;flex-direction:column;">
          <a href="/item/<%= item.id %>" style="position:relative;display:block;">
            <img src="<%= item.image_large || item.image_small %>" alt="<%= item.title %>" style="width:100%;height:180px;object-fit:cover;display:block;">
            <div style="position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent, rgba(0,0,0,0.7));padding:6px 10px;color:#fff;font-size:11px;display:flex;justify-content:space-between;">
              <span><%= item.label || 'FANZA' %></span>
              <span><%= item.volume %></span>
            </div>
          </a>
          <div style="padding:12px;flex:1;display:flex;flex-direction:column;">
            <div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:6px;">
              <% (item.tags || []).slice(0, 3).forEach(function(t) { %>
                <span style="font-size:11px;background:#fdf0f7;color:#d81b60;padding:1px 6px;border-radius:3px;">#<%= t %></span>
              <% }); %>
            </div>
            <a href="/item/<%= item.id %>" style="font-size:14px;font-weight:bold;color:#1d2327;text-decoration:none;line-height:1.4;margin-bottom:8px;">
              <%= item.title %>
            </a>
            <div style="margin-top:auto;padding-top:8px;border-top:1px solid #f0f0f0;display:flex;justify-content:space-between;align-items:center;">
              <span style="color:#d81b60;font-weight:bold;font-size:14px;"><%= item.price_min_text %></span>
              <a href="/item/<%= item.id %>" style="font-size:12px;background:#2271b1;color:#fff;padding:4px 10px;border-radius:4px;text-decoration:none;">詳細・動画</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>

  <!-- Featured Actresses Strip -->
  <div style="background:#fff;border:1px solid #dcdcde;border-radius:8px;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,0.03);">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;border-bottom:2px solid #8e44ad;padding-bottom:8px;">
      <h2 style="margin:0;font-size:20px;color:#1d2327;display:flex;align-items:center;gap:8px;">
        <span style="background:#8e44ad;color:#fff;padding:2px 8px;border-radius:4px;font-size:12px;">ACTRESS</span>
        注目・人気専属女優
      </h2>
      <a href="/actresses" style="font-size:13px;color:#8e44ad;text-decoration:none;">女優一覧へ &raquo;</a>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(130px, 1fr));gap:12px;text-align:center;">
      <% actresses.forEach(function(actress) { %>
        <a href="/actress/<%= actress.id %>" style="display:block;text-decoration:none;padding:10px;border:1px solid #eee;border-radius:8px;background:#fafafa;transition:box-shadow 0.2s;" onmouseover="this.style.boxShadow='0 4px 12px rgba(0,0,0,0.08)'" onmouseout="this.style.boxShadow='none'">
          <img src="<%= actress.image_large || actress.image_small %>" alt="<%= actress.name %>" style="width:90px;height:90px;border-radius:50%;object-fit:cover;margin:0 auto 8px;display:block;border:2px solid #ff4da6;">
          <div style="font-size:13px;font-weight:bold;color:#1d2327;"><%= actress.name %></div>
          <div style="font-size:11px;color:#888;"><%= actress.cup ? actress.cup + 'カップ' : '' %> <%= actress.height ? actress.height + 'cm' : '' %></div>
        </a>
      <% }); %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
