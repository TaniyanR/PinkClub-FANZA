<%- include('admin_header', { title: 'タグ管理', currentRoute: 'tags' }) %>

<div class="admin-dashboard-hero" style="margin-bottom:20px;">
  <div class="admin-dashboard-hero__eyebrow">TAGS</div>
  <h1>タグ・キーワード管理</h1>
  <p class="admin-form-note">商品分類、検索サジェスト、およびサイト内回遊に利用されるタグ一覧です。</p>
</div>

<div class="admin-dashboard-section">
  <h2>登録タグ一覧</h2>
  <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:16px;">
    <% tags.forEach(function(tag) { %>
      <div style="background:#f3f4f6;border:1px solid #e5e7eb;border-radius:20px;padding:6px 14px;font-size:13px;display:flex;align-items:center;gap:8px;">
        <span style="font-weight:bold;color:#1d2327;">#<%= tag %></span>
        <a href="/search?q=<%= encodeURIComponent(tag) %>" target="_blank" style="font-size:11px;color:#2271b1;text-decoration:none;">検索 &raquo;</a>
      </div>
    <% }); %>
  </div>
</div>

<%- include('admin_footer') %>
