<%- include('admin_header', { title: 'アクセス解析', currentRoute: 'analytics' }) %>

<div class="admin-dashboard-hero" style="margin-bottom:20px;">
  <div class="admin-dashboard-hero__eyebrow">ANALYTICS</div>
  <h1>アクセス解析・送客レポート</h1>
  <p class="admin-form-note">サイトPV数、訪問ユニークユーザー（UU）、流入参照元、およびアフィリエイト・外部リンクへの送客推移を確認できます。</p>
</div>

<div class="admin-status-grid" style="margin-bottom:24px;">
  <div class="admin-dashboard-section admin-status-card">
    <strong>本日 PV</strong>
    <p><%= analytics.today_pv %> <span style="font-size:14px;color:#666;">PV</span></p>
  </div>
  <div class="admin-dashboard-section admin-status-card">
    <strong>昨日 PV</strong>
    <p><%= analytics.yesterday_pv %> <span style="font-size:14px;color:#666;">PV</span></p>
  </div>
  <div class="admin-dashboard-section admin-status-card">
    <strong>過去7日間 PV</strong>
    <p><%= analytics.last7_pv.toLocaleString() %> <span style="font-size:14px;color:#666;">PV</span></p>
  </div>
  <div class="admin-dashboard-section admin-status-card">
    <strong>今月累計 PV</strong>
    <p><%= analytics.month_pv.toLocaleString() %> <span style="font-size:14px;color:#666;">PV</span></p>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px;">
  <!-- Referrers Table -->
  <div class="admin-dashboard-section">
    <h2>流入参照元 (リファラー)</h2>
    <table class="admin-table">
      <thead>
        <tr>
          <th>参照元ソース</th>
          <th style="width:100px;">アクセス数</th>
          <th style="width:90px;">構成比</th>
        </tr>
      </thead>
      <tbody>
        <% analytics.referrers.forEach(function(ref) { %>
          <tr>
            <td><strong><%= ref.source %></strong></td>
            <td><%= ref.count %></td>
            <td><span style="background:#eef6fc;color:#2271b1;padding:2px 6px;border-radius:3px;font-size:12px;"><%= ref.percent %></span></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <!-- Destinations Table -->
  <div class="admin-dashboard-section">
    <h2>クリック・送客先 (OUT)</h2>
    <table class="admin-table">
      <thead>
        <tr>
          <th>送客先ターゲット</th>
          <th style="width:100px;">クリック数</th>
          <th style="width:90px;">構成比</th>
        </tr>
      </thead>
      <tbody>
        <% analytics.destinations.forEach(function(dest) { %>
          <tr>
            <td><strong><%= dest.target %></strong></td>
            <td><%= dest.count %></td>
            <td><span style="background:#ffeef6;color:#d81b60;padding:2px 6px;border-radius:3px;font-size:12px;"><%= dest.percent %></span></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('admin_footer') %>
