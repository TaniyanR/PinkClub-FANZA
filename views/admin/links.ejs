<%- include('admin_header', { title: '相互リンク管理', currentRoute: 'links' }) %>

<div class="admin-dashboard-hero" style="margin-bottom:20px;">
  <div class="admin-dashboard-hero__eyebrow">RECIPROCAL LINKS</div>
  <h1>相互リンク管理</h1>
  <p class="admin-form-note">パートナーサイトの掲載管理、IN/OUTアクセス数の確認、新規リンクの追加・削除を行います。</p>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="flash success" style="margin-bottom:16px;">
    <%= success %>
  </div>
<% } %>

<div style="display:grid;grid-template-columns:2fr 1fr;gap:20px;margin-bottom:24px;">
  <!-- Partners Table -->
  <div class="admin-dashboard-section">
    <h2>登録パートナーサイト一覧</h2>
    <table class="admin-table">
      <thead>
        <tr>
          <th style="width:40px;">ID</th>
          <th>サイト名 / URL</th>
          <th style="width:70px;">IN</th>
          <th style="width:70px;">OUT</th>
          <th style="width:80px;">状態</th>
          <th style="width:80px;">操作</th>
        </tr>
      </thead>
      <tbody>
        <% links.forEach(function(link) { %>
          <tr>
            <td><%= link.id %></td>
            <td>
              <strong><%= link.site_name %></strong><br>
              <a href="<%= link.site_url %>" target="_blank" style="font-size:12px;color:#2271b1;"><%= link.site_url %></a>
            </td>
            <td><%= link.in_count %></td>
            <td><%= link.out_count %></td>
            <td>
              <span style="background:#edfaef;color:#174d26;padding:2px 6px;border-radius:3px;font-size:11px;font-weight:bold;">
                <%= link.status === 'approved' ? '掲載中' : '保留' %>
              </span>
            </td>
            <td>
              <form action="/admin/links.php" method="post" onsubmit="return confirm('本当に削除しますか？');" style="display:inline;">
                <input type="hidden" name="action" value="delete">
                <input type="hidden" name="id" value="<%= link.id %>">
                <button type="submit" style="background:#d63638;border-color:#d63638;padding:4px 8px;font-size:12px;min-width:auto;">削除</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <!-- Add Partner Form -->
  <div class="admin-dashboard-section admin-card--form">
    <h2>新規パートナー追加</h2>
    <form action="/admin/links.php" method="post">
      <input type="hidden" name="action" value="add">

      <label>
        <span>サイト名</span>
        <input type="text" name="site_name" required placeholder="例: FANZA人気まとめ">
      </label>

      <label>
        <span>サイトURL</span>
        <input type="url" name="site_url" required placeholder="https://...">
      </label>

      <label>
        <span>RSSフィードURL (任意)</span>
        <input type="url" name="rss_url" placeholder="https://.../rss.xml">
      </label>

      <div class="admin-actions" style="margin-top:16px;">
        <button type="submit">パートナーを追加</button>
      </div>
    </form>
  </div>
</div>

<%- include('admin_footer') %>
