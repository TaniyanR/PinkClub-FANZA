<%- include('admin_header', { title: 'ダッシュボード', currentRoute: 'dashboard' }) %>

<div class="admin-dashboard-hero" style="margin-bottom:20px;">
  <div class="admin-dashboard-hero__eyebrow">ADMIN DASHBOARD</div>
  <h1>PinkClub FANZA 管理ダッシュボード</h1>
  <p class="admin-form-note">サイト全体のステータス、商品・女優データ、同期ログおよび直近のアクセス状況を確認できます。</p>
</div>

<div class="admin-status-grid" style="margin-bottom:24px;">
  <div class="admin-dashboard-section admin-status-card">
    <strong>登録商品数</strong>
    <p><%= stats.items %> <span style="font-size:14px;color:#666;">件</span></p>
  </div>
  <div class="admin-dashboard-section admin-status-card">
    <strong>登録女優数</strong>
    <p><%= stats.actresses %> <span style="font-size:14px;color:#666;">人</span></p>
  </div>
  <div class="admin-dashboard-section admin-status-card">
    <strong>登録ジャンル数</strong>
    <p><%= stats.genres %> <span style="font-size:14px;color:#666;">種</span></p>
  </div>
  <div class="admin-dashboard-section admin-status-card">
    <strong>相互リンクパートナー</strong>
    <p><%= stats.links %> <span style="font-size:14px;color:#666;">サイト</span></p>
  </div>
  <div class="admin-dashboard-section admin-status-card">
    <strong>本日PV / 訪問数</strong>
    <p><%= analytics.today_pv %> <span style="font-size:14px;color:#666;">PV (<%= analytics.today_uu %> UU)</span></p>
  </div>
  <div class="admin-dashboard-section admin-status-card">
    <strong>月間総PV</strong>
    <p><%= analytics.month_pv.toLocaleString() %> <span style="font-size:14px;color:#666;">PV</span></p>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px;">
  <!-- API Sync Status -->
  <div class="admin-dashboard-section">
    <h2>FANZA API 同期状況</h2>
    <table class="admin-table">
      <tbody>
        <tr>
          <th style="width:160px;">自動同期ステータス</th>
          <td>
            <span style="background:#edfaef;color:#174d26;padding:2px 8px;border-radius:4px;font-weight:bold;font-size:12px;">
              稼働中（正常）
            </span>
          </td>
        </tr>
        <tr>
          <th>最終同期日時</th>
          <td><%= settings.last_sync_time || '2026-09-18 12:00:00' %></td>
        </tr>
        <tr>
          <th>同期間隔 / バッチ件数</th>
          <td><%= settings.item_sync_interval || '3' %>時間ごと / <%= settings.item_sync_batch || '10' %>件取得</td>
        </tr>
        <tr>
          <th>アフィリエイトID</th>
          <td><code><%= settings.fanza_affiliate_id || '未設定' %></code></td>
        </tr>
      </tbody>
    </table>
    <div style="margin-top:14px;">
      <a href="/admin/affiliate_api.php" class="button-secondary" style="display:inline-block;text-decoration:none;padding:8px 14px;background:#2271b1;color:#fff;border-radius:4px;font-size:13px;">
        API同期・設定画面を開く &raquo;
      </a>
    </div>
  </div>

  <!-- Quick Operations -->
  <div class="admin-dashboard-section">
    <h2>クイック操作</h2>
    <div style="display:flex;flex-direction:column;gap:10px;margin-top:10px;">
      <a href="/admin/site_settings.php" style="display:flex;align-items:center;justify-content:space-between;padding:12px;border:1px solid #ddd;border-radius:6px;text-decoration:none;color:#1d2327;background:#fafafa;">
        <span><strong>サイト名・SEO・広告コード変更</strong><br><small style="color:#666;">タイトルやタグライン、ヘッダー広告枠の編集</small></span>
        <span style="color:#2271b1;">設定 &raquo;</span>
      </a>
      <a href="/admin/links.php" style="display:flex;align-items:center;justify-content:space-between;padding:12px;border:1px solid #ddd;border-radius:6px;text-decoration:none;color:#1d2327;background:#fafafa;">
        <span><strong>相互リンクの確認・追加</strong><br><small style="color:#666;">パートナーサイトの掲載管理・IN/OUT確認</small></span>
        <span style="color:#2271b1;">管理 &raquo;</span>
      </a>
      <a href="/admin/analytics.php" style="display:flex;align-items:center;justify-content:space-between;padding:12px;border:1px solid #ddd;border-radius:6px;text-decoration:none;color:#1d2327;background:#fafafa;">
        <span><strong>アクセス解析レポート</strong><br><small style="color:#666;">日別PV/UU、参照元URL、アフィリエイト送客ログ</small></span>
        <span style="color:#2271b1;">レポート &raquo;</span>
      </a>
    </div>
  </div>
</div>

<!-- Sync Logs Table -->
<div class="admin-dashboard-section">
  <h2>最新の同期実行ログ</h2>
  <table class="admin-table">
    <thead>
      <tr>
        <th style="width:60px;">ID</th>
        <th style="width:140px;">API名</th>
        <th style="width:180px;">エンドポイント</th>
        <th style="width:100px;">ステータス</th>
        <th style="width:90px;">件数</th>
        <th>メッセージ</th>
        <th style="width:160px;">実行日時</th>
      </tr>
    </thead>
    <tbody>
      <% syncLogs.forEach(function(log) { %>
        <tr>
          <td><%= log.id %></td>
          <td><strong><%= log.api_name %></strong></td>
          <td><code><%= log.endpoint %></code></td>
          <td>
            <% if (log.is_success) { %>
              <span style="color:#28a745;font-weight:bold;">成功 (200)</span>
            <% } else { %>
              <span style="color:#dc3545;font-weight:bold;">失敗</span>
            <% } %>
          </td>
          <td><%= log.item_count %> 件</td>
          <td><%= log.message %></td>
          <td style="font-size:12px;color:#666;"><%= log.created_at %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('admin_footer') %>
