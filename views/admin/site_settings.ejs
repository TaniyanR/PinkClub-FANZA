<%- include('admin_header', { title: 'サイト設定', currentRoute: 'site_settings' }) %>

<div class="admin-dashboard-hero" style="margin-bottom:20px;">
  <div class="admin-dashboard-hero__eyebrow">SETTINGS</div>
  <h1>サイト設定</h1>
  <p class="admin-form-note">サイト全体のタイトル、キャッチコピー、メタキーワード、ヘッダー広告枠などを設定します。</p>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="flash success" style="margin-bottom:16px;">
    サイト設定を保存しました。
  </div>
<% } %>

<div class="admin-dashboard-section admin-card--form">
  <form action="/admin/site_settings.php" method="post">
    <label>
      <span>サイト名</span>
      <input type="text" name="site_name" value="<%= settings.site_name %>" required>
    </label>

    <label>
      <span>サイトキャッチフレーズ (タグライン)</span>
      <input type="text" name="site_tagline" value="<%= settings.site_tagline %>" required>
    </label>

    <label>
      <span>METAキーワード (カンマ区切り)</span>
      <input type="text" name="site_keywords" value="<%= settings.site_keywords %>">
    </label>

    <label>
      <span>ヘッダー上部 広告HTML</span>
      <textarea name="header_ad_html" rows="3"><%= settings.header_ad_html || '' %></textarea>
    </label>

    <label>
      <span>カスタムHEADコード (GA4 / GSC / CSS等)</span>
      <textarea name="custom_head_code" rows="3" placeholder="<script>...</script> または <meta ...>"><%= settings.custom_head_code || '' %></textarea>
    </label>

    <div class="admin-actions" style="margin-top:20px;">
      <button type="submit">設定を保存する</button>
    </div>
  </form>
</div>

<%- include('admin_footer') %>
